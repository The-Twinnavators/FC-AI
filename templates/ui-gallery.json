{
 "ui-shell": [
  {
   "label": "App bar",
   "html": "<header class=\"ui-shell__header\"><div class=\"ui-shell__brand\"><span class=\"ui-shell__name\">Planner</span><span class=\"ui-shell__tagline\">Your week, in one place</span></div><nav class=\"ui-shell__nav\" aria-label=\"Main\"><a class=\"ui-shell__link\" href=\"#/calendar\" aria-current=\"page\">Calendar</a><a class=\"ui-shell__link\" href=\"#/tasks\">Tasks</a><a class=\"ui-shell__link\" href=\"#/settings\">Settings</a></nav></header>"
  },
  {
   "label": "With an action",
   "html": "<header class=\"ui-shell__header\"><div class=\"ui-shell__brand\"><span class=\"ui-shell__name\">Planner</span><span class=\"ui-shell__tagline\">Your week, in one place</span></div><nav class=\"ui-shell__nav\" aria-label=\"Main\"><a class=\"ui-shell__link\" href=\"#/calendar\" aria-current=\"page\">Calendar</a><a class=\"ui-shell__link\" href=\"#/tasks\">Tasks</a><a class=\"ui-shell__link\" href=\"#/settings\">Settings</a></nav><div class=\"ui-shell__actions\"><button class=\"fl-btn fl-btn--primary fl-ctl-btn--32\" data-fl=\"c.button.primary\" type=\"button\">New event</button></div></header>"
  }
 ],
