  {
   "label": "Card",
   "html": "<div class=\"fl-card\" data-fl=\"c.card.surface\"><h3>Weekly summary</h3><div class=\"ui-card__body\"><p>4 events this week, 2 of them today.</p></div><div class=\"ui-card__footer\"><button class=\"fl-btn fl-btn--secondary fl-ctl-btn--32\" data-fl=\"c.button.secondary\" type=\"button\">View all</button></div></div>"
  },
