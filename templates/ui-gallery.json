   "html": "<div class=\"fl-card ui-card--interactive\" data-fl=\"c.card.surface\"><h3>Team planning</h3><div class=\"ui-card__body\"><p>Thursday, 10:00 to 11:00</p></div></div>"
  }
 ],
 "ui-field": [
  {
   "label": "Field",
   "html": "<div class=\"ui-field\"><label class=\"ui-field__label\" for=\"_R_0_\">Event title<span class=\"ui-field__req\"> (required)</span></label><input id=\"_R_0_\" aria-describedby=\"_R_0_-hint\" required=\"\" class=\"ui-input\" placeholder=\"Team standup\"/><p id=\"_R_0_-hint\" class=\"ui-field__hint\">Shown on the calendar.</p></div>"
  },
  {
   "label": "With an error",
   "html": "<div class=\"ui-field ui-field--error\"><label class=\"ui-field__label\" for=\"_R_0_\">Email</label><input id=\"_R_0_\" aria-describedby=\"_R_0_-error\" aria-invalid=\"true\" class=\"ui-input\" value=\"sam@\"/><p id=\"_R_0_-error\" class=\"ui-field__error\" role=\"alert\">Enter an email address like name@example.com.</p></div>"
  },
  {
   "label": "Select",
   "html": "<div class=\"ui-field\"><label class=\"ui-field__label\" for=\"_R_0_\">Repeat</label><select id=\"_R_0_\" class=\"ui-input\"><option value=\"none\">Never</option><option value=\"weekly\" selected=\"\">Every week</option></select></div>"
  }
 ],
 "fl-ctl-badge": [
  {
   "label": "Neutral",
   "html": "<span class=\"fl-ctl-badge fl-ctl-badge--soft fl-ctl-badge--neutral\" data-fl=\"c.badge.status\">Draft</span>"
  },
  {
   "label": "Accent",
   "html": "<span class=\"fl-ctl-badge fl-ctl-badge--soft fl-ctl-badge--info\" data-fl=\"c.badge.status\">New</span>"
