  {
   "label": "Success",
   "html": "<span class=\"fl-ctl-badge fl-ctl-badge--soft fl-ctl-badge--success\" data-fl=\"c.badge.status\">Confirmed</span>"
  },
  {
   "label": "Danger",
   "html": "<span class=\"fl-ctl-badge fl-ctl-badge--soft fl-ctl-badge--danger\" data-fl=\"c.badge.status\">Cancelled</span>"
  }
 ],
 "fl-ctl-alert": [
  {
   "label": "Info",
   "html": "<div role=\"status\" class=\"fl-ctl-alert fl-ctl-alert--info\" data-fl=\"c.alert.info\"><span class=\"fl-ctl-alert-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 16v-5M12 8h.01\"></path></svg></span><span class=\"fl-ctl-alert-text\"><strong>Heads up</strong><span class=\"fl-ctl-matrix-what\">Changes save automatically.</span></span></div>"
  },
  {
   "label": "Success",
   "html": "<div role=\"status\" class=\"fl-ctl-alert fl-ctl-alert--success\" data-fl=\"c.alert.success\"><span class=\"fl-ctl-alert-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12.5 10 17l9-10\"></path></svg></span><span class=\"fl-ctl-alert-text\"><strong>Event created.</strong></span></div>"
  },
  {
   "label": "Warning",
   "html": "<div role=\"status\" class=\"fl-ctl-alert fl-ctl-alert--warning\" data-fl=\"c.alert.warning\"><span class=\"fl-ctl-alert-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0zM12 9v4M12 17h.01\"></path></svg></span><span class=\"fl-ctl-alert-text\"><strong>This overlaps another event.</strong></span></div>"
  },
  {
   "label": "Error",
   "html": "<div role=\"alert\" class=\"fl-ctl-alert fl-ctl-alert--danger\" data-fl=\"c.alert.danger\"><span class=\"fl-ctl-alert-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M18 6 6 18M6 6l12 12\"></path></svg></span><span class=\"fl-ctl-alert-text\"><strong>Couldn&#x27;t save</strong><span class=\"fl-ctl-matrix-what\">Check your connection and try again.</span></span></div>"
  },
  {
   "label": "Error with retry",
   "html": "<div role=\"alert\" class=\"fl-ctl-alert fl-ctl-alert--danger\" data-fl=\"c.alert.danger\"><span class=\"fl-ctl-alert-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M18 6 6 18M6 6l12 12\"></path></svg></span><span class=\"fl-ctl-alert-text\"><strong>Couldn&#x27;t load this</strong><span class=\"fl-ctl-matrix-what\">Check your connection. Nothing you typed was lost.</span></span><button class=\"fl-btn fl-btn--secondary fl-ctl-btn--32\" data-fl=\"c.button.secondary\" type=\"button\">Try again</button></div>"
  }
 ],
 "fl-ctl-tabset": [
  {
   "label": "Tabs",
   "html": "<div data-fl=\"c.tabs.underline\"><div class=\"fl-ctl-tabset fl-ctl-tabset--underline fl-ctl-tabset--40\" role=\"tablist\" aria-label=\"Calendar view\"><button type=\"button\" role=\"tab\" id=\"tab-_R_0_-m\" aria-selected=\"false\" aria-controls=\"panel-_R_0_\" tabindex=\"-1\" class=\"fl-spec-tab\">Month</button><button type=\"button\" role=\"tab\" id=\"tab-_R_0_-w\" aria-selected=\"true\" aria-controls=\"panel-_R_0_\" tabindex=\"0\" class=\"fl-spec-tab is-on\">Week</button><button type=\"button\" role=\"tab\" id=\"tab-_R_0_-d\" aria-selected=\"false\" aria-controls=\"panel-_R_0_\" tabindex=\"-1\" class=\"fl-spec-tab\">Day</button></div><div class=\"fl-ctl-tabpanel\" role=\"tabpanel\" id=\"panel-_R_0_\" aria-labelledby=\"tab-_R_0_-w\" tabindex=\"0\"><p>Week view</p></div></div>"
  },
  {
   "label": "Vertical tabs",
   "html": "<div class=\"fl-ctl-vtabs fl-ctl-vtabs--plain\" data-fl=\"c.tabs.plain\"><div class=\"fl-ctl-vtabs-rail\" role=\"tablist\" aria-orientation=\"vertical\" aria-label=\"Settings\"><button type=\"button\" role=\"tab\" id=\"tab-_R_0_-g\" aria-selected=\"true\" aria-controls=\"panel-_R_0_\" tabindex=\"0\" class=\"fl-ctl-vtab is-on\"><span>General</span></button><button type=\"button\" role=\"tab\" id=\"tab-_R_0_-n\" aria-selected=\"false\" aria-controls=\"panel-_R_0_\" tabindex=\"-1\" class=\"fl-ctl-vtab\"><span>Notifications</span></button><button type=\"button\" role=\"tab\" id=\"tab-_R_0_-p\" aria-selected=\"false\" aria-controls=\"panel-_R_0_\" tabindex=\"-1\" class=\"fl-ctl-vtab\"><span>Privacy</span></button></div><div class=\"fl-ctl-vtabs-panel\" role=\"tabpanel\" id=\"panel-_R_0_\" aria-labelledby=\"tab-_R_0_-g\" tabindex=\"0\"><h4>General</h4><p>General settings</p></div></div>"
  }
 ],
 "fl-ctl-switch": [
  {
   "label": "On",
   "html": "<span style=\"display:contents\"><span class=\"fl-ctl-switch fl-ctl-switch--32\" data-fl=\"c.switch\"><input type=\"checkbox\" aria-label=\"Email reminders\" checked=\"\"/><span class=\"fl-ctl-switch-track\" aria-hidden=\"true\"><span class=\"fl-ctl-switch-thumb\"></span></span></span></span>"
  },
  {
   "label": "Off",
   "html": "<span style=\"display:contents\"><span class=\"fl-ctl-switch fl-ctl-switch--32\" data-fl=\"c.switch\"><input type=\"checkbox\" aria-label=\"Weekly digest\"/><span class=\"fl-ctl-switch-track\" aria-hidden=\"true\"><span class=\"fl-ctl-switch-thumb\"></span></span></span></span>"
  }
 ],
 "ui-settings": [
  {
   "label": "Settings list",
   "html": "<div class=\"ui-settings\"><div class=\"ui-setting\"><div class=\"ui-setting__text\"><label class=\"ui-setting__label\" for=\"_R_1_\">Start week on Monday</label><p id=\"_R_1_-desc\" class=\"ui-setting__desc\">Changes the first column of the month view.</p></div><div class=\"ui-setting__control\"><span style=\"display:contents\"><span class=\"fl-ctl-switch fl-ctl-switch--32\" data-fl=\"c.switch\"><input type=\"checkbox\" aria-label=\"\" checked=\"\"/><span class=\"fl-ctl-switch-track\" aria-hidden=\"true\"><span class=\"fl-ctl-switch-thumb\"></span></span></span></span></div></div><div class=\"ui-setting\"><div class=\"ui-setting__text\"><label class=\"ui-setting__label\" for=\"_R_2_\">Show weekends</label></div><div class=\"ui-setting__control\"><span style=\"display:contents\"><span class=\"fl-ctl-switch fl-ctl-switch--32\" data-fl=\"c.switch\"><input type=\"checkbox\" aria-label=\"\"/><span class=\"fl-ctl-switch-track\" aria-hidden=\"true\"><span class=\"fl-ctl-switch-thumb\"></span></span></span></span></div></div></div>"
  }
 ],
 "fl-crd-kpi": [
  {
   "label": "Stat",
   "html": "<div data-fl=\"c.kpi\" style=\"display:grid\"><div class=\"fl-card fl-crd-kpi\" data-fl=\"c.card.surface\"><h3 class=\"fl-crd-kpi__label\">Events this week</h3><p class=\"fl-crd-kpi__value\">12</p><p class=\"fl-crd-kpi__empty\">3 more than last week</p></div></div>"
