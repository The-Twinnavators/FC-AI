 "fl-spec-empty": [
  {
   "label": "Empty state",
   "html": "<div class=\"fl-spec-empty\" data-fl=\"c.empty-state.first-use\"><span class=\"fl-ctl-empty-art\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 3h18v18H3zM8.5 10a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM21 15l-5-5L5 21\"></path></svg></span><h3 style=\"margin:0;font-size:var(--text-md);font-weight:var(--weight-semibold)\">No events yet</h3><span class=\"fl-ctl-matrix-what\">Add your first event to see it on the calendar.</span><button class=\"fl-btn fl-btn--primary fl-ctl-btn--40\" data-fl=\"c.button.primary\" type=\"button\">New event</button></div>"
  },
  {
   "label": "No results",
   "html": "<div class=\"fl-spec-empty\" data-fl=\"c.empty-state.first-use\"><span class=\"fl-ctl-empty-art\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 3h18v18H3zM8.5 10a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM21 15l-5-5L5 21\"></path></svg></span><h3 style=\"margin:0;font-size:var(--text-md);font-weight:var(--weight-semibold)\">No matches</h3><span class=\"fl-ctl-matrix-what\">Nothing matches your search. Try fewer words or clear the filters.</span><button class=\"fl-btn fl-btn--secondary fl-ctl-btn--40\" data-fl=\"c.button.secondary\" type=\"button\">Clear search</button></div>"
  }
 ],
 "fl-ctl-skel": [
  {
   "label": "Lines",
   "html": "<div role=\"status\" aria-label=\"Loading\"><span style=\"display:grid;gap:var(--space-2)\" data-fl=\"c.skeleton.text\" aria-hidden=\"true\"><span class=\"fl-ctl-skel fl-ctl-skel--title\"></span><span class=\"fl-ctl-skel fl-ctl-skel--title\"></span><span class=\"fl-ctl-skel fl-ctl-skel--title\" style=\"width:60%\"></span></span></div>"
  },
  {
   "label": "Card",
   "html": "<div role=\"status\" aria-label=\"Loading\"><div class=\"fl-ctl-skel-card\" data-fl=\"c.skeleton.card\" aria-hidden=\"true\"><span class=\"fl-ctl-skel fl-ctl-skel--avatar\" data-fl=\"c.skeleton.avatar\" aria-hidden=\"true\"></span><span class=\"fl-ctl-skel-lines\"><span class=\"fl-ctl-skel fl-ctl-skel--title\" data-fl=\"c.skeleton.text\" aria-hidden=\"true\" style=\"width:70%\"></span><span class=\"fl-ctl-skel fl-ctl-skel--sub\" style=\"width:45%\"></span></span></div></div>"
  }
 ],
 "ui-page-header": [
  {
   "label": "Page header",
   "html": "<div class=\"ui-page-header\"><div class=\"ui-page-header__text\"><h1 class=\"ui-page-header__title\">Calendar</h1><p class=\"ui-page-header__desc\">Plan your week and keep track of what&#x27;s next.</p></div><div class=\"ui-page-header__action\"><button class=\"fl-btn fl-btn--primary fl-ctl-btn--40\" data-fl=\"c.button.primary\" type=\"button\">New event</button></div></div>"
  }
 ],
 "ui-section": [
  {
   "label": "Section",
   "html": "<section class=\"ui-section\" aria-labelledby=\"_R_0_\"><div class=\"ui-section__head\"><div><h2 id=\"_R_0_\" class=\"ui-section__title\">Upcoming</h2><p class=\"ui-section__desc\">The next seven days.</p></div></div><p>3 events</p></section>"
  }
 ],
 "ui-checklist": [
  {
   "label": "Checklist",
   "html": "<ul class=\"ui-checklist\" aria-label=\"Getting started\"><li class=\"ui-checklist__item ui-checklist__item--done\"><span class=\"ui-checklist__mark\" aria-hidden=\"true\">✓</span><span class=\"ui-checklist__text\"><span class=\"ui-checklist__title\">Create an account<span class=\"ui-checklist__state ui-sr-only\"> (done)</span></span></span></li><li class=\"ui-checklist__item\"><span class=\"ui-checklist__mark\" aria-hidden=\"true\"></span><span class=\"ui-checklist__text\"><span class=\"ui-checklist__title\">Add your first event</span><span class=\"ui-checklist__meta\">About a minute</span></span></li><li class=\"ui-checklist__item\"><span class=\"ui-checklist__mark\" aria-hidden=\"true\"></span><span class=\"ui-checklist__text\"><span class=\"ui-checklist__title\">Invite your team</span></span></li></ul>"
  }
 ],
 "ui-activity": [
  {
   "label": "Activity",
   "html": "<ul class=\"ui-activity\" aria-label=\"Recent activity\"><li class=\"ui-activity__item\"><span class=\"fl-ctl-avatar fl-ctl-avatar--32 fl-ctl-avatar--e\" data-fl=\"c.avatar.person\" aria-hidden=\"true\"><span aria-hidden=\"true\">SL</span></span><div class=\"ui-activity__text\"><span><strong>Sam Lee</strong> moved Team planning to Thursday</span><span class=\"ui-activity__when\">2 min ago</span></div></li><li class=\"ui-activity__item\"><span class=\"fl-ctl-avatar fl-ctl-avatar--32 fl-ctl-avatar--e\" data-fl=\"c.avatar.person\" aria-hidden=\"true\"><span aria-hidden=\"true\">AR</span></span><div class=\"ui-activity__text\"><span><strong>Ana Ruiz</strong> added Design review</span><span class=\"ui-activity__when\">1 hour ago</span></div></li></ul>"
  }
 ],
 "fl-ctl-tbl": [
  {
   "label": "Table",
   "html": "<div class=\"ui-table\"><p class=\"ui-table__caption\" aria-hidden=\"true\">Upcoming events</p><div data-fl=\"p.data-table\"><p class=\"fl-sr\" role=\"status\" aria-live=\"polite\"></p><div class=\"fl-ctl-tbl-wrap\"><table class=\"fl-ctl-tbl\"><caption class=\"fl-sr\">Upcoming events</caption><thead><tr><th scope=\"col\">Event</th><th scope=\"col\">When</th><th scope=\"col\" class=\"is-num\">Guests</th></tr></thead><tbody><tr><th scope=\"row\">Team standup</th><td>Mon 09:00</td><td class=\"is-num\">6</td></tr><tr><th scope=\"row\">Design review</th><td>Wed 14:00</td><td class=\"is-num\">3</td></tr></tbody></table></div></div></div>"
  }
 ],
 "ui-chart": [
  {
   "label": "Bar chart",
   "html": "<figure class=\"ui-chart\"><figcaption class=\"ui-chart__title\">Events per day</figcaption><ol class=\"ui-chart__bars\"><li class=\"ui-chart__item\"><span class=\"ui-chart__value\">4</span><span class=\"ui-chart__bar\" style=\"height:80%\" aria-hidden=\"true\"></span><span class=\"ui-chart__label\">Mon</span></li><li class=\"ui-chart__item\"><span class=\"ui-chart__value\">2</span><span class=\"ui-chart__bar\" style=\"height:40%\" aria-hidden=\"true\"></span><span class=\"ui-chart__label\">Tue</span></li><li class=\"ui-chart__item\"><span class=\"ui-chart__value\">5</span><span class=\"ui-chart__bar\" style=\"height:100%\" aria-hidden=\"true\"></span><span class=\"ui-chart__label\">Wed</span></li><li class=\"ui-chart__item\"><span class=\"ui-chart__value\">3</span><span class=\"ui-chart__bar\" style=\"height:60%\" aria-hidden=\"true\"></span><span class=\"ui-chart__label\">Thu</span></li><li class=\"ui-chart__item\"><span class=\"ui-chart__value\">1</span><span class=\"ui-chart__bar\" style=\"height:20%\" aria-hidden=\"true\"></span><span class=\"ui-chart__label\">Fri</span></li></ol></figure>"
  }
 ],
 "ui-hero": [
  {
   "label": "Hero",
   "html": "<div class=\"ui-hero\"><div class=\"ui-hero__copy\"><span class=\"ui-hero__eyebrow\">Welcome back</span><h1 class=\"ui-hero__title\">Your week at a glance</h1><p class=\"ui-hero__desc\">Three events today, the first at 09:00.</p><div class=\"ui-hero__actions\"><button class=\"fl-btn fl-btn--primary fl-ctl-btn--40\" data-fl=\"c.button.primary\" type=\"button\">Open calendar</button></div></div></div>"
  }
 ],
 "ui-tile": [
  {
   "label": "Action tile",
   "html": "<button type=\"button\" class=\"ui-tile\"><span class=\"ui-tile__title\">New event</span><span class=\"ui-tile__desc\">Add something to your calendar.</span></button>"
  }
 ],
 "ui-grid": [
  {
   "label": "Stats grid",
   "html": "<div class=\"ui-grid ui-grid--stats\"><div data-fl=\"c.kpi\" style=\"display:grid\"><div class=\"fl-card fl-crd-kpi\" data-fl=\"c.card.surface\"><h3 class=\"fl-crd-kpi__label\">Today</h3><p class=\"fl-crd-kpi__value\">3</p></div></div><div data-fl=\"c.kpi\" style=\"display:grid\"><div class=\"fl-card fl-crd-kpi\" data-fl=\"c.card.surface\"><h3 class=\"fl-crd-kpi__label\">This week</h3><p class=\"fl-crd-kpi__value\">12</p></div></div><div data-fl=\"c.kpi\" style=\"display:grid\"><div class=\"fl-card fl-crd-kpi\" data-fl=\"c.card.surface\"><h3 class=\"fl-crd-kpi__label\">Overdue</h3><p class=\"fl-crd-kpi__value\">0</p></div></div></div>"
  }
 ]
}
